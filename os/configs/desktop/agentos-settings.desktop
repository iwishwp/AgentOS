[Desktop Entry]
Type=Application
Name=System Settings
Name[zh_CN]=系统设置
Comment=AgentOS
Comment[zh_CN]=AgentOS
# gnome-control-center 在非 GNOME 会话直接拒启（实测 "only supported under GNOME"），
# AgentOS 的设置入口指向真正可用的 Noctalia 设置面板
Exec=qs -c noctalia ipc call settings open
Icon=org.gnome.Settings
Terminal=false
Categories=Settings;System;
