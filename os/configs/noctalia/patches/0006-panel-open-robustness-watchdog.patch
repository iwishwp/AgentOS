+              openWatchdogTimer.start();
+            }
 
-          // Start open watchdog timer (skip when animations disabled - everything completes synchronously)
-          if (!root.animationsDisabled) {
-            root.openWatchdogActive = true;
-            openWatchdogTimer.start();
+            opened();
