diff --git a/Services/Media/SpectrumService.qml b/Services/Media/SpectrumService.qml
index 5cdd2b5..21f9068 100644
--- a/Services/Media/SpectrumService.qml
+++ b/Services/Media/SpectrumService.qml
@@ -42,25 +42,14 @@ Singleton {
   property var values: []
   property bool isIdle: true
 
-  PwAudioSpectrum {
+  // AGENTOS-PATCH(noctalia-v4.7.1/01): PwAudioSpectrum 类型在 Fedora quickshell
+  // 0.2.1^git20260209 中不存在。用惰性 QtObject 桩掉频谱数据源：
+  // values 恒为空数组、idle 恒为 true，频谱视觉化显示为静止，其余功能不受影响。
+  // quickshell 升级后还原本块即可（见 AgentOS docs/noctalia.md）。
+  QtObject {
     id: spectrum
-    node: Pipewire.defaultAudioSink
-    enabled: root._shouldRun
-    // TODO Uncomment this in may 2026
-    // bandCount: Settings.data.audio.spectrumMirrored ? 32 : 64
-    frameRate: Settings.data.audio.spectrumFrameRate
-    lowerCutoff: 50
-    upperCutoff: 12000
-    noiseReduction: 0.77
-    smoothing: true
-
-    onValuesChanged: {
-      root.values = spectrum.values;
-    }
-
-    onIdleChanged: {
-      root.isIdle = spectrum.idle;
-    }
+    readonly property var values: []
+    readonly property bool idle: true
   }
 
   // TODO Remove in may 2026 - temporary until noctalia-qs is fully propagated
