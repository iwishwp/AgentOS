// =============================================================================
// 水族馆（agent 嵌套会话）专用最小配置——session-mcp 以 `niri -c 本文件` 启动。
//
// 设计原则（2026-10-25 用户定）：馆内默认启动的 app 越少越好——它只服务 agent
// 操作，不承载桌面体验。因此：
//   * 零 spawn-at-startup（主配置里的 mako/noctalia/orb/goose 等一律不复制进馆，
//     曾因 -c 指向主配置导致馆内全套重复启动：双悬浮球/馆内 goose/嵌套壁纸壳）
//   * 键位只留用户围观/接管时最低可用集（关窗/退出）
//   * 不弹开机速查浮层（skip-at-startup）
// 环境继承：同一用户同一 HOME——文件全共享；D-Bus 会话总线共用（keyring/通知/
// portal 走主会话服务）；agent 浏览器按设计用独立 profile（凭据走 broker 通道 A）。
// =============================================================================

hotkey-overlay {
    skip-at-startup
}

// 馆内应用默认全屏打开——单 app 即整屏（2026-10-26）；agent 需要对照多窗时用形态键收小
window-rule {
    open-fullscreen true
}

// 兜底：单列铺满工作区宽（即使个别应用拒 fullscreen hint 也视觉全屏）
layout {
    default-column-width { proportion 1.0; }
}

binds {
    // 接管围观时的最低键位：关掉馆内焦点窗口 / 整馆退出（退出也可用主会话关窗）
    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Shift+Left { set-column-width "50%"; }
    Mod+Shift+Right { center-column; }
    Mod+Shift+E { quit; }
    Mod+Return { spawn "ghostty"; }
}
