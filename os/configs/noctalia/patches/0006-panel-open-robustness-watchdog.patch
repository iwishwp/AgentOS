diff --git a/Services/Control/CurrentScreenDetector.qml b/Services/Control/CurrentScreenDetector.qml
index 8ab719e..38b2347 100644
--- a/Services/Control/CurrentScreenDetector.qml
+++ b/Services/Control/CurrentScreenDetector.qml
@@ -105,6 +105,12 @@ Item {
                     root.pendingCallback = callback;
                     root.pendingSkipBarCheck = !!skipBarCheck;
                     screenDetectorLoader.active = true;
+                    // AGENTOS-PATCH(noctalia-v4.7.1/0006): arm a timeout — if the
+                    // invisible window never reports a screen, pendingCallback used
+                    // to hang forever and every later withCurrentScreen() call was
+                    // silently dropped ("Another detection is pending"), killing
+                    // all panel opens until shell restart.
+                    screenDetectorTimeout.restart();
                   }
 
                     Timer {
@@ -141,6 +147,29 @@ Item {
 
                         // Clean up
                         screenDetectorLoader.active = false;
+                        // AGENTOS-PATCH(noctalia-v4.7.1/0006)
+                        screenDetectorTimeout.stop();
+                      }
+                    }
+
+                    // AGENTOS-PATCH(noctalia-v4.7.1/0006): recover a stuck screen
+                    // detection instead of dropping every subsequent call forever.
+                    Timer {
+                      id: screenDetectorTimeout
+                      interval: 800
+                      onTriggered: {
+                        if (root.pendingCallback) {
+                          Logger.w("CurrentScreenDetector", "Screen detection timed out, falling back to bar screen");
+                          var callback = root.pendingCallback;
+                          root.pendingCallback = null;
+                          root.pendingSkipBarCheck = false;
+                          screenDetectorLoader.active = false;
+                          try {
+                            callback(root.findScreenWithBar());
+                          } catch (e) {
+                            Logger.e("CurrentScreenDetector", "Fallback callback failed:", e);
+                          }
+                        }
                       }
                     }
 
