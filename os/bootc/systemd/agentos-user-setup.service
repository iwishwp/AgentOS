# AgentOS 默认配置部署（user 单元，所有镜像构建均全局启用）
# 每次图形会话启动时把 /usr/share/agentos/defaults/ 的默认配置
# only-if-absent 部署到 ~/.config/（幂等，不覆盖用户改动）。
# 设计说明：docs/m5-atomic.md §配置分发。
[Unit]
Description=AgentOS user setup (deploy default configs, only-if-absent)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/share/agentos/bin/firstboot-config.sh
# 环境变量：graphical-session 用户单元里 HOME 已正确设置；
# 无需 restart——失败下次登录自然重跑（oneshot 幂等）
RemainAfterExit=no

[Install]
WantedBy=graphical-session.target
