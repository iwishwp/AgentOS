# AgentOS settings 守护进程（主题/设置编排常驻化）
# 安装：
#   cp agentos-settings.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now agentos-settings
# 自检：journalctl --user -u agentos-settings -f；agentos-settings status
[Unit]
Description=AgentOS settings daemon (theme orchestration: watchers + bridges + D-Bus)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/node %h/AgentOS/packages/settings-daemon/dist/index.js daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
