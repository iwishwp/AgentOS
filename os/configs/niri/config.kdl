// AgentOS 默认 niri 配置模板
//
// 键位方案借鉴 Omarchy（DHH 的 Arch+Hyprland 发行版，文档站 omarchy.org，
// 仓库 github.com/basecamp/omarchy —— 现跳转至 github.com/omacom/omarchy），
// 原则：用到哪些功能就抄哪些键位，不照单全收。
// 完整调研与取舍理由：docs/omarchy-keybindings-research.md；用户侧说明：docs/keyboard.md
//
// 语法对照 niri 官方默认配置（仓库 resources/default-config.kdl）与
// wiki 键位文档（https://niri-wm.github.io/niri/Configuration:-Key-Bindings），
// 动作名逐个核对过拼写（2026-10，niri 26.04 为 VM 实测版本）。
//
// ✅ 2026-10-17 已在真机 niri 26.04（FC44 aarch64 VM）原样 `niri validate` 通过
//（含本文件 include 的 aesthetics.kdl；ghostty 毛玻璃 window-rule 同批验证）。
//
// ⚠️ 重要语义：binds 段一旦出现，niri 内置的完整默认键位即被整体替换
// （不与默认值合并——wiki 明确提醒过）。因此本文件就是完整键位表；
// 焦点移动等默认键位只保留了子集需要的部分，需要更多时从官方
// default-config.kdl 里拷贝对应行。

// 通知守护进程（desktop-mcp 的通知工具依赖它）
// 开机不再弹内置速查浮层（速查走 Super+K 我们的浮层；内置版仍可 Mod+Shift+Slash 手动唤起）
hotkey-overlay {
    show-at-startup false
}

spawn-at-startup "mako"

// polkit 认证代理（M4 T2 装包链的密码弹窗；QT_LINUX_ACCESSIBILITY_ALWAYS_ON
// 让 atspi 桥可驱动认证框——实测 Qt6 默认不开无障碍树，2026-10-17）
spawn-at-startup "env" "QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1" "/usr/libexec/lxqt-policykit-agent"

// 状态栏/桌面 shell（Noctalia v4.7.1 + AgentOS 兼容补丁；安装见 scripts/install-noctalia.sh，
// 版本论证见 docs/noctalia.md。waybar 配置保留在 os/configs/waybar/ 作为回退）
spawn-at-startup "qs" "-c" "noctalia"

// goose 悬浮球（常驻：干活进展 + 待确认提醒，安装见 scripts/install-orb.sh，设计 docs/orb.md）
spawn-at-startup "qs" "-c" "agentos-orb"

// goose desktop（Electron 图形版，用户交互首要入口）：内置 goose CLI（ACP），
// 与 goose TUI 共用 ~/.config/goose/config.yaml（MCP 扩展/GLM provider）。
// 启动器注入 goose.env 密钥 + Wayland/a11y 参数（keyring 坑见 docs/goose-desktop.md）；
// RPM 包（Goose-1.55.0-1.arm64）需 Mac 中转安装，见同文。路径按部署机用户名调整
spawn-at-startup "/home/demon/AgentOS/scripts/launch-goose-desktop.sh"

// 美学配置（布局/动画/色板），见 os/configs/theming/niri/aesthetics.kdl
// include 语义为文档拼接：layout 与 animations 段只在那个文件里定义，勿在此重复
include "./aesthetics.kdl"

// 截图保存路径（strftime(3) 格式；截图同时会进入剪贴板；设为 null 可不落盘）
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // ============ 启动应用 ============

    // 终端（ghostty）：Omarchy 的 Super+Return 原样采纳，实现换为 ghostty
    //（默认终端切换调研见 docs/ghostty.md；alacritty 保留为回退，bootc 镜像线仍用它）
    Super+Return { spawn "ghostty"; }

    // 终端别名：niri 默认 Mod+T 保留（现有文档与肌肉记忆沿用）。
    // 不用 Super+T 开终端：Omarchy 里 Super+T 是"平铺/浮动切换"而非终端，
    // 且 Mac 用户 ⌘T=新标签页的肌肉记忆容易误开一串终端——详见 docs/keyboard.md
    Mod+T hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }

    // 启动器（fuzzel）：Omarchy 的 Super+Space（Omarchy menu）键位原样采纳，
    // 菜单实现换成我们实际用的 fuzzel
    Super+Space { spawn "agentos-launcher"; }

    // 唤起 goose desktop（首要对话入口；再次启动走 Electron 单实例锁 → 聚焦已有窗口）
    Super+G hotkey-overlay-title="Goose" { spawn "/home/demon/AgentOS/scripts/launch-goose-desktop.sh"; }

    // 启动器别名：niri 默认 Mod+D 保留
    // 启动器统一入口：Noctalia 启动面板（与状态栏同款），回退 fuzzel（scripts/agentos-launcher.sh）
    Mod+D hotkey-overlay-title="App Launcher" { spawn "agentos-launcher"; }

    // 浏览器（firefox）：Omarchy 的 Super+Shift+Return 原样采纳
    //（Omarchy 按发行版默认浏览器启动，我们固定为 firefox）
    Super+Shift+Return { spawn "firefox"; }

    // ============ 窗口操作 ============

    // 关闭窗口：Omarchy 的 Super+W 原样采纳
    //（代价：niri 默认把该键给"标签页显示"，该功能不在子集内，让位）
    Super+W { close-window; }

    // 关闭窗口别名：niri 默认 Mod+Q 保留——在 TTY 会话上 Mod 即 Super，
    // 与 Omarchy 的 Super+Q 是同一个物理键、同一语义
    Mod+Q repeat=false { close-window; }

    // 关闭窗口别名：通用惯例 Alt+F4 保留（niri 默认）
    Alt+F4 repeat=false { close-window; }

    // 全屏：Omarchy 的 Super+F 键位原样采纳。
    // 动作取 niri 的真全屏 fullscreen-window（替换 niri 默认在此键上的 maximize-column）
    Super+F { fullscreen-window; }

    // 平铺全屏：Omarchy 的 Super+Ctrl+F"Tiled full screen"，
    // 对应 niri 的 maximize-column（撑满但保留边距/边框的"全屏"）
    Super+Ctrl+F { maximize-column; }

    // ============ 工作区 ============

    // 切换到工作区 1-9：Omarchy（Super+数字）与 niri 默认（Mod+数字）本就一致
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // 下一个/上一个工作区：Omarchy 的 Super+Tab / Super+Shift+Tab 原样采纳。
    // niri 的工作区是纵向栈，focus-workspace-down/up 即"顺序的下一个/上一个"
    Super+Tab      { focus-workspace-down; }
    Super+Shift+Tab { focus-workspace-up; }

    // 回到上一个使用的工作区：Omarchy 的 Super+Ctrl+Tab"Former workspace"键位原样采纳，
    // 动作是 niri 官方示例中的 focus-workspace-previous（当前↔上一个来回切）
    Super+Ctrl+Tab { focus-workspace-previous; }

    // 工作区纵向切换别名：niri 默认 Mod+U / Mod+I 保留（与 Super+Tab 对等）
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }

    // 把当前窗口（列）移到工作区 1-9：Omarchy 的 Super+Shift+数字 原样采纳。
    // niri 的窗口单位是"列"，move-column-to-workspace 与 Omarchy 的
    // "move window to workspace"语义等价（单窗口列即窗口本身）
    Super+Shift+1 { move-column-to-workspace 1; }
    Super+Shift+2 { move-column-to-workspace 2; }
    Super+Shift+3 { move-column-to-workspace 3; }
    Super+Shift+4 { move-column-to-workspace 4; }
    Super+Shift+5 { move-column-to-workspace 5; }
    Super+Shift+6 { move-column-to-workspace 6; }
    Super+Shift+7 { move-column-to-workspace 7; }
    Super+Shift+8 { move-column-to-workspace 8; }
    Super+Shift+9 { move-column-to-workspace 9; }

    // 移动窗口别名：niri 默认 Mod+Ctrl+数字 保留
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ============ 总览 / 截图 / 锁屏 / 退出 ============

    // niri 总览（缩放鸟瞰所有工作区与窗口）：niri 原生保留
    //（Omarchy/Hyprland 默认键位无此概念）。
    // 注意动作名是 toggle-overview，不是 overview——以 wiki 为准核对过
    Mod+O repeat=false { toggle-overview; }

    // 截图（交互式 UI：选区/窗口/整屏，复制进剪贴板并落盘）：
    // Omarchy 与 niri 默认都在 Print 键上，一致采纳
    Print { screenshot; }

    // 截图别名：Omarchy 的 Super+Shift+S 原样采纳——
    // Mac 键盘没有 Print 键，这是 Mac + Fusion 用户的主路径
    Super+Shift+S { screenshot; }

    // 直接整屏截图 / 当前窗口截图：niri 默认保留
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 锁屏：Omarchy 的 Super+Ctrl+L 原样采纳
    //（Omarchy 同样是拉起外部锁屏器，我们的锁屏器是 swaylock）
    Super+Ctrl+L { spawn "swaylock"; }

    // 锁屏别名：niri 官方建议键位 Super+Alt+L 保留
    Super+Alt+L hotkey-overlay-title="Lock: swaylock" { spawn "swaylock"; }

    // 退出 niri：niri 默认 Mod+Shift+E 保留（quit 自带确认对话框，防误触）。
    // Omarchy 的 Super+Escape"系统菜单"未采纳：niri 没有 power-off-menu 之类的
    // 系统菜单动作（以 wiki 动作清单核对），退出语义由 quit 承担；
    // Super+Escape 这个键位保留给下面 niri 默认的"快捷键抑制逃生门"
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // ============ 保留的 niri 默认（可用性垫底，非 Omarchy 借鉴） ============

    // 键位速查，两层分工（2026-10-17 起）：
    //   Super+K → canvas 键位速查页 http://127.0.0.1:7788/keys（Omarchy 心智的
    //     "可翻页键位表"）：系统莫兰迪配色（Noctalia colors.json）、整页上下滚动、
    //     输入即过滤；数据实时解析本文件 binds 段，改键位页面自动跟随，无手工副本
    //     （实现：packages/canvas 的 keys 模块）。
    //   Mod+Shift+Slash → niri 内置 hotkey overlay 保留，作 canvas 服务不可用时的兜底。
    // chromium 参数对齐 packages/browser-mcp 的实测结论：--password-store=basic 必须
    // （keyring 锁定时网络栈挂死的教训）；Fedora 可执行名是 chromium-browser
    // （其他发行版可能叫 chromium，探测逻辑见 browser-mcp 的 detectChromiumBin）
    Mod+Shift+Slash { show-hotkey-overlay; }
    Super+K hotkey-overlay-title="Keys: 键位速查浮层" { spawn "qs" "-c" "agentos-hotkeys"; }

    // 快捷键抑制逃生门（niri 默认）：远程桌面类应用可请求合成器停用快捷键，
    // 此键反制，避免被恶意/异常应用"劫持键盘"（allow-inhibiting=false 保证永远生效）
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // 焦点移动（方向键）：niri 默认保留——没有它们，多窗口时无法用键盘切焦点
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // 移动窗口/列位置（方向键）：niri 默认保留
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
}

// ============ 终端毛玻璃（ghostty + Catppuccin Frappé 配套） ============
//
// ghostty 1.3.x 在 Linux 上的 background-blur 只走 KDE 私有协议
// （org_kde_kwin_blur_manager），niri 不实现它 → ghostty 自带模糊在 niri 下无效
// （真机 A/B 实证见 docs/ghostty.md）。niri 26.04 起提供组合器侧窗口规则
// background-effect，对任意半透明窗口强制模糊，与客户端是否请求无关——
// 毛玻璃由这里 + ghostty 的 background-opacity = 0.85 共同达成。
//
// 语义注意（niri Window Effects 文档）：
//  * 窗口必须半透明才能看到效果（ghostty 侧 background-opacity 负责）；
//  * 规则式模糊跟随窗口的 geometry-corner-radius（本仓库 aesthetics.kdl 未设，
//    即默认直角；若将来设圆角，模糊区域自动跟随）；
//  * 非 xray 模糊（模糊下方真实内容）目前为 experimental——VM 26.04 实测正常，
//    niri 升级若异常，删掉本块即可退回纯半透明。
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    background-effect {
        blur true
    }
}
